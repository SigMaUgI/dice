local rng = Random.new()
local function previewColor()
    local remembered = optionByKey[memory.Key or ""]
    local pool = {}
    for _, option in ipairs(OPTIONS) do
        if not remembered or option.key ~= remembered.key then
            table.insert(pool, option)
        end
    end
    return pool[rng:NextInteger(1, #pool)].color
end

local function pickColor()
    local remembered = optionByKey[memory.Key or ""]
    if remembered and rng:NextNumber() < 0.05 then
        return remembered.color
    end
    local pool = {}
    for _, option in ipairs(OPTIONS) do
        if not remembered or option.key ~= remembered.key then
            table.insert(pool, option)
        end
    end
    return pool[rng:NextInteger(1, #pool)].color
end

local function shuffle(list)
    for index = #list, 2, -1 do
        local swapWith = rng:NextInteger(1, index)
        list[index], list[swapWith] = list[swapWith], list[index]
    end
    return list
end

local function animateRoll(includeOpponentColor)
    local remembered = optionByKey[memory.Key or ""]
    local results = {}

    if remembered then
        local otherColors = {}
        for _, option in ipairs(OPTIONS) do
            if option.key ~= remembered.key then
                table.insert(otherColors, option.color)
            end
        end
        shuffle(otherColors)

        -- Three different colors; none match Player 2 at first.
        for index = 1, 3 do
            results[index] = otherColors[index]
        end

        -- Across the whole multi-spin run, only one randomly chosen roll
        -- receives Player 2's color, and only one die receives it.
        if includeOpponentColor then
            results[rng:NextInteger(1, 3)] = remembered.color
        end
    else
        local shuffledOptions = {}
        for _, option in ipairs(OPTIONS) do
            table.insert(shuffledOptions, option)
        end
        shuffle(shuffledOptions)
        results = {
            shuffledOptions[1].color,
            shuffledOptions[2].color,
            shuffledOptions[3].color
        }
    end

    local frames = 15

    for frame = 1, frames do
        local progress = frame / frames
        local pause = 0.025 + (progress * progress * 0.055)

        for index = 1, 3 do
            local direction = index == 2 and -1 or 1
            local phase = frame + index * 2
            dice[index].BackgroundColor3 = previewColor()
            dice[index].Rotation = direction * (phase * 37 % 180 - 90)
            diceGradients[index].Rotation = (phase * 49 * direction) % 360
            diceGradients[index].Offset = Vector2.new(math.sin(phase) * 0.45, 0)
        end

        task.wait(pause)
    end

    for index = 1, 3 do
        dice[index].BackgroundColor3 = results[index]
        dice[index].Rotation = (index == 2 and -14 or 14)
        diceGradients[index].Offset = Vector2.new(-0.15, 0)

        TweenService:Create(dice[index], TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Rotation = 0
        }):Play()
        TweenService:Create(diceGradients[index], TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Rotation = 25,
            Offset = Vector2.new(0, 0)
        }):Play()
    end

    task.wait(0.3)
    return results
end

local function getRoundWinner(results)
    local remembered = optionByKey[memory.Key or ""]
    if not remembered then
        return nil
    end

    local matches = 0
    for _, resultColor in ipairs(results) do
        if resultColor == remembered.color then
            matches += 1
        end
    end

    -- Player 2 needs the remembered Trade Chat color at least twice.
    if matches >= 2 then
        return 2
    else
        return 1
    end
end

local function showFinalWinner(playerOneWins, playerTwoWins)
    if playerOneWins > playerTwoWins then
        winner.Text = "PLAYER 1 WON"
        winner.TextColor3 = Color3.fromRGB(45, 156, 255)
        winnerStroke.Color = Color3.fromRGB(45, 156, 255)
    elseif playerTwoWins > playerOneWins then
        winner.Text = "PLAYER 2 WON"
        winner.TextColor3 = Color3.fromRGB(64, 214, 120)
        winnerStroke.Color = Color3.fromRGB(64, 214, 120)
    else
        winner.Text = "DRAW"
        winner.TextColor3 = Color3.fromRGB(255, 194, 51)
        winnerStroke.Color = Color3.fromRGB(255, 194, 51)
    end
end

local spinning = false
spin.MouseButton1Click:Connect(function()
    if spinning then return end
    local spinCount = math.clamp(math.floor(tonumber(amountBox.Text) or 1), 1, 100)
    amountBox.Text = tostring(spinCount)
    spinning = true
    spin.Text = "SPINNING"
    spin.BackgroundColor3 = Color3.fromRGB(35, 142, 72)
    local playerOneWins = 0
    local playerTwoWins = 0

    winner.Text = "ROLLING..."
    winner.TextColor3 = Color3.fromRGB(154, 163, 184)
    winnerStroke.Color = Color3.fromRGB(75, 84, 104)

    local opponentColorRoll = nil
    if optionByKey[memory.Key or ""] then
        opponentColorRoll = rng:NextInteger(1, spinCount)
    end

    for roll = 1, spinCount do
        local results = animateRoll(roll == opponentColorRoll)
        local roundWinner = getRoundWinner(results)
        if roundWinner == 1 then
            playerOneWins += 1
        elseif roundWinner == 2 then
            playerTwoWins += 1
        end
        if roll < spinCount then task.wait(1) end
    end

    if not optionByKey[memory.Key or ""] then
        winner.Text = "WAITING FOR TRADE COLOR"
        winner.TextColor3 = Color3.fromRGB(255, 194, 51)
        winnerStroke.Color = Color3.fromRGB(255, 194, 51)
    else
        showFinalWinner(playerOneWins, playerTwoWins)
    end

    spinning = false
    spin.Text = "SPIN"
    spin.BackgroundColor3 = Color3.fromRGB(43, 196, 92)
end)

local dragging, dragInput, dragStart, startPosition = false, nil, nil, nil
main.InputBegan:Connect(function(input)
