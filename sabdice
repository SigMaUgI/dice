local function remember(option, source)
    if source and source:IsDescendantOf(gui) then return end
    memory.Name = option.label
    memory.Key = option.key
    memory.Color = option.color
    memory.SeenAt = os.clock()
    memory.Source = source
end

local function isInsideClickable(object)
    local ancestor = object
    while ancestor and ancestor ~= playerGui do
        if ancestor:IsA("TextButton") or ancestor:IsA("ImageButton") then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

local function inspect(object, isNew)
    if not (object:IsA("TextLabel") or object:IsA("TextButton")) then return end

    local function check(allowClickable)
        if object:IsDescendantOf(gui) then return end
        if isInsideClickable(object) and not allowClickable then return end
        local option = optionByKey[normalize(object.Text)]
        if option and object.Visible and object.AbsoluteSize.X > 0 and object.AbsoluteSize.Y > 0 then
            remember(option, object)
        end
    end

    -- Existing clickable preset controls are ignored. Newly created chat rows,
    -- or an existing chat row whose text changes, are accepted.
    check(isNew)
    object:GetPropertyChangedSignal("Text"):Connect(function()
        check(true)
    end)
    object:GetPropertyChangedSignal("Visible"):Connect(function()
        check(false)
    end)
end

